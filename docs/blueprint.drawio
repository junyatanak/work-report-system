                </mxCell>
                <mxCell id="cp_wuLTPE9M4Np_4hW1N-1" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;text-decoration:underline;&quot;&gt;&lt;b&gt;2222:WorkReport&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Order Id = 3333&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Process Id = 1000&lt;br&gt;&lt;br&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="730" y="70" width="160" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="IdrAshBj3K3QuwYVTwmi-1" value="&lt;p style=&quot;margin:0px;margin-top:4px;text-align:center;text-decoration:underline;&quot;&gt;&lt;b&gt;3333:Production Order&lt;/b&gt;&lt;/p&gt;&lt;hr size=&quot;1&quot; style=&quot;border-style:solid;&quot;&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Process Name = Correction Tape A&lt;/p&gt;&lt;p style=&quot;margin:0px;margin-left:8px;&quot;&gt;Quantity = 10,000&lt;br&gt;&lt;br&gt;&lt;/p&gt;" style="verticalAlign=top;align=left;overflow=fill;html=1;whiteSpace=wrap;" parent="1" vertex="1">
                    <mxGeometry x="730" y="-100" width="160" height="90" as="geometry"/>
                </mxCell>
                <mxCell id="j6aNv32yU2OQVKq66LEL-1" value="最初は現行のProcessIdと名前をそのまま引き継いで、Taskという形で必要な粒度で集計できるようにする。Process Idの統合は運用後。&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=center;" parent="1" vertex="1">
                    <mxGeometry x="570" y="220" width="270" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="j6aNv32yU2OQVKq66LEL-2" value="" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;dashed=1;" parent="1" source="j6aNv32yU2OQVKq66LEL-1" edge="1">
                    <mxGeometry width="100" relative="1" as="geometry">
                        <mxPoint x="600" y="210" as="sourcePoint"/>
                        <mxPoint x="610" y="170" as="targetPoint"/>
                        <Array as="points"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="j6aNv32yU2OQVKq66LEL-5" value="" style="edgeStyle=none;orthogonalLoop=1;jettySize=auto;html=1;endArrow=none;endFill=0;dashed=1;entryX=0.186;entryY=0.926;entryDx=0;entryDy=0;entryPerimeter=0;" parent="1" target="j6aNv32yU2OQVKq66LEL-1" edge="1">
                    <mxGeometry width="100" relative="1" as="geometry">
                        <mxPoint x="605" y="380" as="sourcePoint"/>
                        <mxPoint x="585" y="310" as="targetPoint"/>
                        <Array as="points"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="j6aNv32yU2OQVKq66LEL-6" value="&lt;div&gt;開発初期段階は、組立・包装工程にしぼる。Taskクラスは廃止し、Processクラスの属性値として、最小作業単位、最小セット数を登録する。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Taskクラスは設計を複雑化するだけで、分析にはプロセスクラスの属性値だけで十分と判断した。1サイクルの出来高という属性を入れることで、組立・包装、印刷・スリット工程も同じクラスで対応できそう。&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=center;" parent="1" vertex="1">
                    <mxGeometry x="400" y="340" width="300" height="230" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
