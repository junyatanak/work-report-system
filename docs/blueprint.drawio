                <mxCell id="UJ6AxX5f7dKY7ZNBd3sc-2" value="登録待ち入力データ件数が&lt;div&gt;1件以上の場合、押下できる&lt;/div&gt;" style="strokeWidth=1;shadow=0;dashed=0;align=center;html=1;shape=mxgraph.mockup.text.callout;linkText=;textSize=17;textColor=#666666;callDir=SW;callStyle=line;fontSize=11;fontColor=#666666;align=left;verticalAlign=bottom;strokeColor=#666666;" parent="1" vertex="1">
