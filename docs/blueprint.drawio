                <mxCell id="KytO9MeYXYM0n-OUr5SJ-3" value="Order No" style="text;html=1;align=center;verticalAlign=middle;resizable=0;points=[];autosize=1;strokeColor=none;fillColor=none;fontSize=15;" parent="1" vertex="1">
                    <mxGeometry x="45" y="60" width="90" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="KytO9MeYXYM0n-OUr5SJ-4" value="11111111" style="strokeWidth=1;shadow=0;dashed=0;align=center;html=1;shape=mxgraph.mockup.text.textBox;fontColor=#666666;align=left;fontSize=17;spacingLeft=4;spacingTop=-3;whiteSpace=wrap;strokeColor=#666666;mainText=" parent="1" vertex="1">
                    <mxGeometry x="141" y="60" width="143.5" height="30" as="geometry"/>
                </mxCell>
                <mxCell id="kIvnj5qDQRBkNVZphA21-3" value="製造オーダー番号を入力すると、&lt;div&gt;DBからオーダーの情報を拾ってきて、&lt;/div&gt;&lt;div&gt;ItemNameおよび&lt;/div&gt;&lt;div&gt;オーダー数量は自動入力される&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;オーダー番号がない場合の入力方法は、&lt;/div&gt;&lt;div&gt;要検討。&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="strokeWidth=1;shadow=0;dashed=0;align=center;html=1;shape=mxgraph.mockup.text.callout;linkText=;textSize=17;textColor=#666666;callDir=SW;callStyle=line;fontSize=11;fontColor=#666666;align=left;verticalAlign=bottom;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="-205.5" y="79" width="242.5" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="5nvGmSx00tSMZq1UXykp-1" value="&lt;span style=&quot;color: rgb(102, 102, 102); font-size: 11px; text-wrap-mode: nowrap;&quot;&gt;BreakTimeは&lt;/span&gt;&lt;span style=&quot;font-size: 11px; text-wrap-mode: nowrap; background-color: transparent;&quot;&gt;選択式にしてもよい。&lt;/span&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 11px; text-wrap-mode: nowrap;&quot;&gt;クッキーによって&lt;span style=&quot;background-color: transparent;&quot;&gt;デフォルト値の選択値を&lt;/span&gt;&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 11px; text-wrap-mode: nowrap;&quot;&gt;決められると便利。&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 11px; text-wrap-mode: nowrap;&quot;&gt;Start TImeとEndTimeから、&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 11px; text-wrap-mode: nowrap;&quot;&gt;休憩時間に異常がないかチェック入れる。&lt;/div&gt;&lt;div style=&quot;color: rgb(63, 63, 63); scrollbar-color: rgb(226, 226, 226) rgb(251, 251, 251); font-size: 11px; text-wrap-mode: nowrap;&quot;&gt;&lt;br&gt;&lt;/div&gt;" style="shape=note2;boundedLbl=1;whiteSpace=wrap;html=1;size=25;verticalAlign=top;align=left;" vertex="1" parent="1">
                    <mxGeometry x="580" y="210" width="210" height="120" as="geometry"/>
                </mxCell>
