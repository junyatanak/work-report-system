                <mxCell id="pzNK4bQ1xGklcqc_uKNq-2" value="入力件数によって&lt;div&gt;行数を調整する&lt;/div&gt;" style="strokeWidth=1;shadow=0;dashed=0;align=center;html=1;shape=mxgraph.mockup.text.callout;linkText=;textSize=17;textColor=#666666;callDir=SW;callStyle=line;fontSize=11;fontColor=#666666;align=left;verticalAlign=bottom;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="-163" y="370" width="200" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="CVAyAMlY-c6ihg9ZnCKC-3" value="プロセス番号は作業者が&lt;div&gt;事前に知っている必要がある。&lt;/div&gt;&lt;div&gt;どのようなプロセスで目標時間&lt;/div&gt;&lt;div&gt;はどれくらいか一目で分かる&lt;/div&gt;&lt;div&gt;一覧表が必要&lt;/div&gt;" style="strokeWidth=1;shadow=0;dashed=0;align=center;html=1;shape=mxgraph.mockup.text.callout;linkText=;textSize=17;textColor=#666666;callDir=SW;callStyle=line;fontSize=11;fontColor=#666666;align=left;verticalAlign=bottom;strokeColor=#666666;" parent="1" vertex="1">
                    <mxGeometry x="-210" y="160" width="242.5" height="100" as="geometry"/>
                </mxCell>
                <mxCell id="UJ6AxX5f7dKY7ZNBd3sc-1" value="登録待ちの入力データ件数を&lt;div&gt;()内で表示する&lt;/div&gt;" style="strokeWidth=1;shadow=0;dashed=0;align=center;html=1;shape=mxgraph.mockup.text.callout;linkText=;textSize=17;textColor=#666666;callDir=SW;callStyle=line;fontSize=11;fontColor=#666666;align=left;verticalAlign=bottom;strokeColor=#666666;" parent="1" vertex="1">
