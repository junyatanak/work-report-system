                    <mxGeometry y="185" width="565" height="215" as="geometry"/>
                </mxCell>
                <mxCell id="MCTKhrlRUAeGr0Cup-vq-50" value="基本フロー" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#f5f5f5;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontColor=#333333;align=left;" parent="MCTKhrlRUAeGr0Cup-vq-49" vertex="1">
                    <mxGeometry width="110" height="215" as="geometry">
                        <mxRectangle width="110" height="215" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="MCTKhrlRUAeGr0Cup-vq-51" value="&lt;ol&gt;&lt;li&gt;登録済みユーザは作業記録の登録を指示する。&lt;/li&gt;&lt;li&gt;システムは作業記録の登録画面を表示する。&lt;/li&gt;&lt;li&gt;登録済みユーザは作業実績を入力し、Stockボタンを押下する。&lt;/li&gt;&lt;li&gt;システムは内容をチェックして、登録待ちデータとして保留する。&lt;/li&gt;&lt;li&gt;登録済みユーザはCheckボタンを押下すると、システムは登録待ちの作業一覧を表示して、確認を促す。&lt;/li&gt;&lt;li&gt;登録済みユーザーは内容を確認し、確定を指示する。&lt;/li&gt;&lt;li&gt;システムは登録内容を確定し、登録作業が完了したことを表示し、ホーム画面に戻る。&lt;/li&gt;&lt;/ol&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;verticalAlign=top;" parent="MCTKhrlRUAeGr0Cup-vq-49" vertex="1">
                    <mxGeometry x="110" width="455" height="215" as="geometry">
                        <mxRectangle width="455" height="215" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="MCTKhrlRUAeGr0Cup-vq-52" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;strokeColor=inherit;top=0;left=0;bottom=0;right=0;collapsible=0;dropTarget=0;fillColor=none;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;" parent="MCTKhrlRUAeGr0Cup-vq-36" vertex="1">
                    <mxGeometry y="400" width="565" height="110" as="geometry"/>
                </mxCell>
                <mxCell id="MCTKhrlRUAeGr0Cup-vq-53" value="代替フロー" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=#666666;overflow=hidden;fillColor=#f5f5f5;top=0;left=0;bottom=0;right=0;pointerEvents=1;fontColor=#333333;align=left;" parent="MCTKhrlRUAeGr0Cup-vq-52" vertex="1">
                    <mxGeometry width="110" height="110" as="geometry">
                        <mxRectangle width="110" height="110" as="alternateBounds"/>
                    </mxGeometry>
                </mxCell>
                <mxCell id="MCTKhrlRUAeGr0Cup-vq-54" value="3a. Stock ボタンを押したとき&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;3a1.&amp;nbsp; システムは入力された内容を「登録待ち」として保留する&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;3a2.&amp;nbsp; 入力フォームの内容をリセットして、基本フロー2に戻る&lt;br&gt;&lt;/div&gt;&lt;div&gt;5a. 確認画面で修正が生じた場合&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;4a1.&amp;nbsp; 確認画面で修正する作業記録を選択して、修正または削除する&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;4a2.&amp;nbsp; 修正する場合は基本フロー3に戻り、該当の作業記録の内容を表示する。&lt;br&gt;&lt;/div&gt;" style="shape=partialRectangle;html=1;whiteSpace=wrap;connectable=0;strokeColor=inherit;overflow=hidden;fillColor=none;top=0;left=0;bottom=0;right=0;pointerEvents=1;align=left;" parent="MCTKhrlRUAeGr0Cup-vq-52" vertex="1">
