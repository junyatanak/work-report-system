                <mxCell id="zgPbL3tP3bCU_nrdcQ8e-1" value="Daily Work Report System" style="shape=umlFrame;whiteSpace=wrap;html=1;pointerEvents=0;recursiveResize=0;container=1;collapsible=0;width=160;" parent="1" vertex="1">
