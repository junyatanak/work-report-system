@model DailyWorkReport.ViewModels.WorkReport.WorkReportCreateViewModel

@{
    ViewData["Title"] = "Create Work Report";
}

<h1 class="h3 mb-4">
    <i class="bi bi-file-earmark-plus text-primary me-2"></i>Create Work Report
</h1>

<form asp-action="Create" method="post">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h2 class="h6 text-uppercase text-muted mb-3">Basic Info</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Reporter</label>
                    <input class="form-control" value="@User.Identity!.Name" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="WorkDate" class="form-label"></label>
                    <input asp-for="WorkDate" type="date" class="form-control" />
                    <span asp-validation-for="WorkDate" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h2 class="h6 text-uppercase text-muted mb-3">
                <i class="bi bi-clipboard-check me-1"></i>Production Order
            </h2>

            <div class="row g-3">
                <div class="col-md-4">
                    <label asp-for="ProductionOrderNumber" class="form-label"></label>
                    <input asp-for="ProductionOrderNumber" id="productionOrderNumber" class="form-control" autocomplete="off" placeholder="Enter order number" />
                    <span asp-validation-for="ProductionOrderNumber" class="text-danger"></span>
                    <span id="productionOrderError" class="text-danger small"></span>
                </div>
            </div>

            <input asp-for="ProductionOrderId" id="productionOrderId" type="hidden" />
            <input asp-for="WorkClassId" id="workClassId" type="hidden" />
            <span asp-validation-for="ProductionOrderId" class="text-danger"></span>

            <hr class="my-3" />

            <div class="row g-3">
                <div class="col-md-3">
                    <label class="form-label small text-muted" for="productCode">Product Code</label>
                    <input asp-for="ProductCode" id="productCode" class="form-control form-control-sm bg-light" disabled />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted" for="productName">Product Name</label>
                    <input asp-for="ProductName" id="productName" class="form-control form-control-sm bg-light" disabled />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted" for="orderQty">Order Qty</label>
                    <input asp-for="OrderQty" id="orderQty" class="form-control form-control-sm bg-light" disabled />
                </div>
                <div class="col-md-3">
                    <label class="form-label small text-muted" for="dueDate">Due Date</label>
                    <input asp-for="DueDate" id="dueDate" class="form-control form-control-sm bg-light" disabled />
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h2 class="h6 text-uppercase text-muted mb-3">
                <i class="bi bi-gear me-1"></i>Work Details
            </h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small text-muted" for="workClassName">Work Class</label>
                    <input asp-for="WorkClassName" id="workClassName" class="form-control form-control-sm bg-light" disabled />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="processId">Process</label>
                    <select asp-for="ProcessId" id="processId" asp-items="Model.ProcessOptions" class="form-select" disabled="@(!Model.ProcessOptions.Any())">
                        <option value="">-- Select production order first --</option>
                    </select>
                    <span asp-validation-for="ProcessId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="workPatternId">Work Pattern</label>
                    <select asp-for="WorkPatternId" id="workPatternId" asp-items="Model.WorkPatternOptions" class="form-select" disabled="@(!Model.WorkPatternOptions.Any())">
                        <option value="">-- Select process first --</option>
                    </select>
                    <span asp-validation-for="WorkPatternId" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h6 text-uppercase text-muted mb-0">
                    <i class="bi bi-people me-1"></i>Workers
                </h2>
                <button type="button" id="addWorkerBtn" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>Add Worker
                </button>
            </div>

            @{
                var workerErrorKeys = ViewData.ModelState.Keys
                    .Where(k => k.StartsWith("WorkReportWorkers"))
                    .ToList();
            }
            @if(workerErrorKeys.Any()){
                <div class="alert alert-danger py-2">
                    <ul class="mb-0 ps-3">
                        @foreach(var key in workerErrorKeys){
                            foreach(var error in ViewData.ModelState[key]!.Errors){
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="workersTable">
                    <thead>
                        <tr class="text-muted small text-uppercase">
                            <th style="width: 12%;">Worker No.</th>
                            <th style="width: 18%;">Worker Name</th>
                            <th style="width: 13%;">Start</th>
                            <th style="width: 13%;">End</th>
                            <th style="width: 14%;">Break</th>
                            <th style="width: 15%;">Produced Qty</th>
                            <th style="width: 5%;"></th>
                        </tr>
                    </thead>
                    <tbody id="workersTableBody">
                        @for (int i = 0; i < Model.WorkReportWorkers.Count; i++)
                        {
                            var worker = Model.WorkReportWorkers[i];
                            <tr>
                                <td>
                                    <input type="number" name="WorkReportWorkers[@i].WorkerNumber" value="@worker.WorkerNumber" class="form-control form-control-sm worker-number" autocomplete="off" />
                                    <span class="text-danger small worker-number-error"></span>
                                </td>
                                <td>
                                    <input type="text" value="@worker.WorkerName" class="form-control form-control-sm bg-light worker-name" disabled />
                                    <input type="hidden" name="WorkReportWorkers[@i].WorkerId" value="@worker.WorkerId" class="worker-id" />
                                </td>
                                <td>
                                    <input type="time" name="WorkReportWorkers[@i].StartAt" value="@worker.StartAt.ToString("HH:mm")" class="form-control form-control-sm" />
                                </td>
                                <td>
                                    <input type="time" name="WorkReportWorkers[@i].EndAt" value="@worker.EndAt.ToString("HH:mm")" class="form-control form-control-sm" />
                                </td>
                                <td>
                                    <select name="WorkReportWorkers[@i].BreakMinutes" class="form-select form-select-sm">
                                        <option value="0" selected="@(worker.BreakMinutes == 0)">0 min</option>
                                        <option value="30" selected="@(worker.BreakMinutes == 30)">30 min</option>
                                        <option value="40" selected="@(worker.BreakMinutes == 40)">40 min</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="WorkReportWorkers[@i].ProducedQty" value="@worker.ProducedQty" class="form-control form-control-sm" />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-outline-danger btn-sm remove-worker-btn">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }                       
                    </tbody>
                </table>
            </div>

            <p id="noWorkersMessage" class="text-muted text-center small py-3 mb-0">
                No workers added yet. Click "Add Worker" to get started.
            </p>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-check-lg me-1"></i>Save
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
    </div>
</form>

@section Scripts{
    <partial name="_ValidationScriptsPartial" />
    <script>
        let workerIndex = @Model.WorkReportWorkers.Count;

        function createWorkerRow(){
            const index = workerIndex++;
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>
                    <input type="number" name="WorkReportWorkers[${index}].WorkerNumber" class="form-control form-control-sm worker-number" autocomplete="off" />
                    <span class="text-danger small worker-number-error"></span>
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm bg-light worker-name" disabled />
                    <input type="hidden" name="WorkReportWorkers[${index}].WorkerId" class="worker-id" />
                </td>
                <td>
                    <input type="time" name="WorkReportWorkers[${index}].StartAt" class="form-control form-control-sm"/>
                </td>
                <td>
                    <input type="time" name="WorkReportWorkers[${index}].EndAt" class="form-control form-control-sm"/>
                </td>
                <td>
                    <select name="WorkReportWorkers[${index}].BreakMinutes" class="form-select form-select-sm">
                        <option value="0">0 min</option>
                        <option value="30">30 min</option>
                        <option value="40">40 min</option>
                    </select>
                </td>
                <td>
                    <input type="number" name="WorkReportWorkers[${index}].ProducedQty" class="form-control form-control-sm" />
                </td>
                <td>
                    <button type="button" class="btn btn-outline-danger btn-sm remove-worker-btn">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;
            return tr;
        }
            
        function updateNoWorkersMessage(){
            const tbody = document.getElementById('workersTableBody');
            const message = document.getElementById('noWorkersMessage');
            message.style.display = tbody.children.length === 0 ? 'block' : 'none';
        }

        document.getElementById('addWorkerBtn').addEventListener('click', function(){
            const tbody = document.getElementById('workersTableBody');
            tbody.appendChild(createWorkerRow());
            updateNoWorkersMessage();
        });

        document.getElementById('workersTableBody').addEventListener('click', function(event){
            const button = event.target.closest('.remove-worker-btn');
            if(button){
                button.closest('tr').remove();
                updateNoWorkersMessage();
            }
        });

        document.getElementById('productionOrderNumber').addEventListener('blur', async function(){
            const orderNumber = this.value.trim();
            const errorEl = document.getElementById('productionOrderError');

            const productCodeEl = document.getElementById('productCode');
            const productNameEl = document.getElementById('productName');
            const orderQtyEl = document.getElementById('orderQty');
            const dueDateEl = document.getElementById('dueDate');
            const workClassNameEl = document.getElementById('workClassName');
            const productionOrderIdEl = document.getElementById('productionOrderId');
            const workClassIdEl = document.getElementById('workClassId');
            const processSelectEl = document.getElementById('processId');
            const workPatternSelectEl = document.getElementById('workPatternId');
            
            errorEl.textContent = '';
            productCodeEl.value = '';
            productNameEl.value = '';
            orderQtyEl.value = '';
            dueDateEl.value = '';
            workClassNameEl.value = '';
            productionOrderIdEl.value = '';
            workClassIdEl.value = '';

            resetSelect(processSelectEl, '-- Select production order first --');
            resetSelect(workPatternSelectEl, '-- Select process first --');

            if(!orderNumber){
                return;
            }

            try{
                const response = await fetch(`/WorkReports/FindProductionOrderByNumber?orderNumber=${encodeURIComponent(orderNumber)}`);

                if(response.ok){
                    const order = await response.json();
                    
                    productCodeEl.value = order.productCode;
                    productNameEl.value = order.productName;
                    orderQtyEl.value = order.orderQty;
                    dueDateEl.value = order.dueDate;
                    workClassNameEl.value = order.workClassName;
                    productionOrderIdEl.value = order.productionOrderId;
                    workClassIdEl.value = order.workClassId;

                    await loadProcessOptions(order.workClassId);
                } else {
                    errorEl.textContent = 'Production order not found.';
                }
            } catch {
                errorEl.textContent = 'Failed to check production order number. Please try again.';
            }
        });

        function resetSelect(selectEl, placeholderText) {
            selectEl.innerHTML = `<option value="">${placeholderText}</option>`;
            selectEl.disabled = true;
        }
        async function loadProcessOptions(workClassId) {
            const processSelectEl = document.getElementById('processId');

            try {
                const response = await fetch(`/WorkReports/GetProcessOptions?workClassId=${workClassId}`);
                const processes = await response.json();

                processSelectEl.innerHTML = '<option value="">-- Select --</option>';
                processes.forEach(p => {
                    const option = document.createElement('option');
                    option.value = p.processId;
                    option.textContent = p.name;
                    processSelectEl.appendChild(option);
                });
                processSelectEl.disabled = false;
            } catch {
                processSelectEl.innerHTML = '<option value="">-- Failed to load --</option>';
            }
        }

        document.getElementById('processId').addEventListener('change', async function() {
            const processId = this.value;
            const workClassId = document.getElementById('workClassId').value;
            const workPatternSelectEl = document.getElementById('workPatternId');

            resetSelect(workPatternSelectEl, '-- Select process first --');

            if(!processId || !workClassId){
                return ;
            }

            try{
                const response = await fetch(`/WorkReports/GetWorkPatternOptions?workClassId=${workClassId}&processId=${processId}`);
                const workPatterns = await response.json();

                workPatternSelectEl.innerHTML = '<option value="">-- Select --</option>';
                workPatterns.forEach(w => {
                    const option = document.createElement('option');
                    option.value = w.workPatternId;
                    option.textContent = w.name;
                    workPatternSelectEl.appendChild(option);
                });
                workPatternSelectEl.disabled = false;
            } catch {
                workPatternSelectEl.innerHTML = '<option value="">-- Failed to load --</option>';
            }
        });

        updateNoWorkersMessage();
    </script>
}