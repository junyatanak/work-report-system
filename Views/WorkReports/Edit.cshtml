@model DailyWorkReport.ViewModels.WorkReport.WorkReportEditViewModel

@{
    ViewData["Title"] = "Edit Work Report";
}

<h1 class="h3 mb-4">
    <i class="bi bi-pencil-square text-primary me-2"></i>Edit Work Report
</h1>

<form asp-action="Edit" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="ReporterName" type="hidden" />
    <input asp-for="ProductionOrderNumber" type="hidden" />
    <input asp-for="ProductCode" type="hidden" />
    <input asp-for="ProductName" type="hidden" />
    <input asp-for="OrderQty" type="hidden" />
    <input asp-for="DueDate" type="hidden" />
    <input asp-for="WorkClassName" type="hidden" />
    <input asp-for="WorkClassId" id="workClassId" type="hidden" />

    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h2 class="h6 text-uppercase text-muted mb-3">Basic Info</h2>
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label">Reporter</label>
                    <input asp-for="ReporterName" class="form-control" disabled />
                </div>
                <div class="col-md-6">
                    <label asp-for="WorkDate" class="form-label"></label>
                    <input asp-for="WorkDate" type="date" class="form-control" />
                    <span asp-validation-for="WorkDate" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h2 class="h6 text-uppercase text-muted mb-3">
                <i class="bi bi-clipboard-check me-1"></i>Production Order
            </h2>
            <div class="row row-cols-md-5 g-3">
                <div class="col">
                    <label class="form-label small text-muted mb-0">Order No.</label>
                    <p class="mb-0">@Model.ProductionOrderNumber</p>
                </div>
                <div class="col">
                    <label class="form-label small text-muted mb-0">Product Code</label>
                    <p class="mb-0">@Model.ProductCode</p>
                </div>
                <div class="col">
                    <label class="form-label small text-muted mb-0">Product Name</label>
                    <p class="mb-0">@Model.ProductName</p>
                </div>
                <div class="col">
                    <label class="form-label small text-muted mb-0">Order Qty</label>
                    <p class="mb-0">@Model.OrderQty</p>
                </div>
                <div class="col">
                    <label class="form-label small text-muted mb-0">Due Date</label>
                    <p class="mb-0">@Model.DueDate.ToString("yyyy-MM-dd")</p>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <h2 class="h6 text-uppercase text-muted mb-3">
                <i class="bi bi-gear me-1"></i>Work Details
            </h2>
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label small text-muted">Work Class</label>
                    <input asp-for="WorkClassName" class="form-control form-control-sm bg-light" disabled />
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="processId">Process</label>
                    <select asp-for="ProcessId" id="processId" asp-items="Model.ProcessOptions" class="form-select">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="ProcessId" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" for="workPatternId">Work Pattern</label>
                    <select asp-for="WorkPatternId" id="workPatternId" asp-items="Model.WorkPatternOptions" class="form-select">
                        <option value="">-- Select --</option>
                    </select>
                    <span asp-validation-for="WorkPatternId" class="text-danger"></span>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mb-4">
        <div class="card-body">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h2 class="h6 text-uppercase text-muted mb-0">
                    <i class="bi bi-people me-1"></i>Workers
                </h2>
                <button type="button" id="addWorkerBtn" class="btn btn-primary btn-sm">
                    <i class="bi bi-plus-lg me-1"></i>Add Worker
                </button>
            </div>

            @{
                var workerErrorKeys = ViewData.ModelState.Keys
                    .Where(k => k.StartsWith("WorkReportWorkers"))
                    .ToList();
            }
            @if (workerErrorKeys.Any())
            {
                <div class="alert alert-danger py-2">
                    <ul class="mb-0 ps-3">
                        @foreach (var key in workerErrorKeys)
                        {
                            foreach (var error in ViewData.ModelState[key]!.Errors)
                            {
                                <li>@error.ErrorMessage</li>
                            }
                        }
                    </ul>
                </div>
            }
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="workersTable">
                    <thead>
                        <tr class="text-muted small text-uppercase">
                            <th style="width: 12%;">Worker No.</th>
                            <th style="width: 18%;">Worker Name</th>
                            <th style="width: 13%;">Start</th>
                            <th style="width: 13%;">End</th>
                            <th style="width: 14%;">Break</th>
                            <th style="width: 15%;">Produced Qty</th>
                            <th style="width: 5%;"></th>
                        </tr>
                    </thead>
                    <tbody id="workersTableBody">
                        @for (int i = 0; i < Model.WorkReportWorkers.Count; i++)
                        {
                            var worker = Model.WorkReportWorkers[i];
                            <tr>
                                <td>
                                    <input type="number" name="WorkReportWorkers[@i].WorkerNumber" value="@worker.WorkerNumber" class="form-control form-control-sm worker-number" autocomplete="off" />
                                    <span class="text-danger small worker-number-error"></span>
                                </td>
                                <td>
                                    <input type="text" value="@worker.WorkerName" class="form-control form-control-sm bg-light worker-name" disabled />
                                    <input type="hidden" name="WorkReportWorkers[@i].WorkerId" value="@worker.WorkerId" class="worker-id" />
                                </td>
                                <td>
                                    <input type="time" name="WorkReportWorkers[@i].StartAt" value="@worker.StartAt.ToString("HH:mm")" class="form-control form-control-sm" />
                                </td>
                                <td>
                                    <input type="time" name="WorkReportWorkers[@i].EndAt" value="@worker.EndAt.ToString("HH:mm")" class="form-control form-control-sm" />
                                </td>
                                <td>
                                    <select name="WorkReportWorkers[@i].BreakMinutes" class="form-select form-select-sm">
                                        <option value="0" selected="@(worker.BreakMinutes == 0)">0 min</option>
                                        <option value="30" selected="@(worker.BreakMinutes == 30)">30 min</option>
                                        <option value="40" selected="@(worker.BreakMinutes == 40)">40 min</option>
                                    </select>
                                </td>
                                <td>
                                    <input type="number" name="WorkReportWorkers[@i].ProducedQty" value="@worker.ProducedQty" class="form-control form-control-sm" />
                                </td>
                                <td>
                                    <button type="button" class="btn btn-outline-danger btn-sm remove-worker-btn">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            <p id="noWorkersMessage" class="text-muted text-center small py-3 mb-0">
                No workers added yet. Click "Add Worker" to get started.
            </p>
        </div>
    </div>

    <div class="d-flex gap-2">
        <button type="submit" class="btn btn-primary px-4">
            <i class="bi bi-check-lg me-1"></i>Save
        </button>
        <a asp-action="Index" class="btn btn-outline-secondary px-4">Cancel</a>
    </div>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        let workerIndex = @Model.WorkReportWorkers.Count;

        function createWorkerRow() {
            const index = workerIndex++;
            const tr = document.createElement('tr');
            tr.innerHTML = `
                <td>
                    <input type="number" name="WorkReportWorkers[${index}].WorkerNumber" class="form-control form-control-sm worker-number" autocomplete="off" />
                    <span class="text-danger small worker-number-error"></span>
                </td>
                <td>
                    <input type="text" class="form-control form-control-sm bg-light worker-name" disabled />
                    <input type="hidden" name="WorkReportWorkers[${index}].WorkerId" class="worker-id" />
                </td>
                <td>
                    <input type="time" name="WorkReportWorkers[${index}].StartAt" class="form-control form-control-sm" />
                </td>
                <td>
                    <input type="time" name="WorkReportWorkers[${index}].EndAt" class="form-control form-control-sm" />
                </td>
                <td>
                    <select name="WorkReportWorkers[${index}].BreakMinutes" class="form-select form-select-sm">
                        <option value="0">0 min</option>
                        <option value="30">30 min</option>
                        <option value="40">40 min</option>
                    </select>
                </td>
                <td>
                    <input type="number" name="WorkReportWorkers[${index}].ProducedQty" class="form-control form-control-sm" />
                </td>
                <td>
                    <button type="button" class="btn btn-outline-danger btn-sm remove-worker-btn">
                        <i class="bi bi-trash"></i>
                    </button>
                </td>
            `;
            return tr;
        }

        function updateNoWorkersMessage() {
            const tbody = document.getElementById('workersTableBody');
            const message = document.getElementById('noWorkersMessage');
            message.style.display = tbody.children.length === 0 ? 'block' : 'none';
        }

        document.getElementById('addWorkerBtn').addEventListener('click', function () {
            const tbody = document.getElementById('workersTableBody');
            tbody.appendChild(createWorkerRow());
            updateNoWorkersMessage();
        });

        document.getElementById('workersTableBody').addEventListener('click', function (event) {
            const button = event.target.closest('.remove-worker-btn');
            if (button) {
                button.closest('tr').remove();
                updateNoWorkersMessage();
            }
        });

        document.getElementById('processId').addEventListener('change', async function () {
            const processId = this.value;
            const workClassId = document.getElementById('workClassId').value;
            const workPatternSelectEl = document.getElementById('workPatternId');

            workPatternSelectEl.innerHTML = '<option value="">-- Select process first --</option>';

            if (!processId || !workClassId) {
                return;
            }

            try {
                const response = await fetch(`/WorkReports/GetWorkPatternOptions?workClassId=${workClassId}&processId=${processId}`);
                const workPatterns = await response.json();

                workPatternSelectEl.innerHTML = '<option value="">-- Select --</option>';
                workPatterns.forEach(w => {
                    const option = document.createElement('option');
                    option.value = w.workPatternId;
                    option.textContent = w.name;
                    workPatternSelectEl.appendChild(option);
                });
            } catch {
                workPatternSelectEl.innerHTML = '<option value="">-- Failed to load --</option>';
            }
        });

        document.getElementById('workersTableBody').addEventListener('blur', async function (event) {
            if (!event.target.classList.contains('worker-number')) {
                return;
            }

            const input = event.target;
            const workerNumber = input.value.trim();
            const row = input.closest('tr');
            const errorEl = row.querySelector('.worker-number-error');
            const nameEl = row.querySelector('.worker-name');
            const idEl = row.querySelector('.worker-id');

            errorEl.textContent = '';
            nameEl.value = '';
            idEl.value = '';

            if (!workerNumber) {
                return;
            }

            try {
                const response = await fetch(`/WorkReports/FindWorkerByNumber?workerNumber=${encodeURIComponent(workerNumber)}`);

                if (response.ok) {
                    const worker = await response.json();
                    nameEl.value = worker.name ?? '';
                    idEl.value = worker.id;
                } else {
                    errorEl.textContent = 'Worker not found.';
                }
            } catch {
                errorEl.textContent = 'Failed to check worker number. Please try again.';
            }
        }, true);

        updateNoWorkersMessage();

    </script>
}