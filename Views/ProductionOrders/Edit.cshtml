@model DailyWorkReport.ViewModels.ProductionOrder.ProductionOrderEditViewModel

@{
    ViewData["Title"] = "Edit Production Order";
}

<h1 class="h3 mb-3">Edit Production Order</h1>

<form asp-action="Edit" method="post" class="col-md-6">
    <input asp-for="Id" type="hidden" />
    <input asp-for="RowVersion" type="hidden" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    @if (ViewBag.ConflictDetected == true)
    {
        <div class="alert alert-warning d-flex flex-column flex-md-row align-items-md-center justify-content-between gap-3 mb-4" role="alert">
            <div>
                <h5 class="alert-heading mb-1">This record was updated by another user</h5>
                <p class="mb-0">
                    Your changes were not saved. Please reload the latest content and re-enter your changes.
                </p>
            </div>
            <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning text-nowrap">
                Reload latest content
            </a>
        </div>
    }

    <div class="mb-3">
        <label asp-for="OrderNumber" class="form-label"></label>
        <input asp-for="OrderNumber" class="form-control" />
        <span asp-validation-for="OrderNumber" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ProductCode" class="form-label"></label>
        <input asp-for="ProductCode" id="productCode" class="form-control" autocomplete="off" />
        <span asp-validation-for="ProductCode" class="text-danger"></span>
        <span id="productCodeError" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label class="form-label" for="productName">Product Name</label>
        <input asp-for="ProductName" id="productName" class="form-control" disabled />
        <input asp-for="ProductId" id="productId" type="hidden" />
        <span asp-validation-for="ProductId" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="OrderQty" class="form-label"></label>
        <input asp-for="OrderQty" class="form-control" />
        <span asp-validation-for="OrderQty" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="DueDate" class="form-label"></label>
        <input asp-for="DueDate" type="date" class="form-control" />
        <span asp-validation-for="DueDate" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary" disabled="@(ViewBag.ConflictDetected == true)">
        Save
    </button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('productCode').addEventListener('blur', async function () {
            const code = this.value.trim();
            const errorEl = document.getElementById('productCodeError');
            const nameEl = document.getElementById('productName');
            const idEl = document.getElementById('productId');

            errorEl.textContent = '';
            nameEl.value = '';
            idEl.value = '';

            if(!code) {
                return;
            }

            try {
                const response = await fetch(`/ProductionOrders/FindProductByCode?code=${encodeURIComponent(code)}`);
                if(response.ok) {
                    const product = await response.json();
                    nameEl.value = product.name;
                    idEl.value = product.id;
                } else {
                    errorEl.textContent = 'Product not found.';
                }
            } catch {
                errorEl.textContent = 'Failed to check product code. Please try again.';
            }
        });
    </script>
}
