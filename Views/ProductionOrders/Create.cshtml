@model DailyWorkReport.ViewModels.ProductionOrder.ProductionOrderCreateViewModel

@{
    ViewData["Title"] = "Create Production Order";
}

<h1 class="h3 mb-3">Create Production Order</h1>

<form asp-action="Create" method="post" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

    <div class="mb-3">
        <label asp-for="OrderNumber" class="form-label"></label>
        <input asp-for="OrderNumber" class="form-control" />
        <span asp-validation-for="OrderNumber" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="ProductCode" class="form-label"></label>
        <input asp-for="ProductCode" id="productCode" class="form-control" autocomplete="off" />
        <span id="productCodeError" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Product Name</label>
        <input id="productName" class="form-control" disabled />
        <input asp-for="ProductId" id="productId" type="hidden" />
        <span asp-validation-for="ProductId" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="OrderQty" class="form-label"></label>
        <input asp-for="OrderQty" class="form-control" />
        <span asp-validation-for="OrderQty" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="DueDate" class="form-label"></label>
        <input asp-for="DueDate" type="date" class="form-control" />
        <span asp-validation-for="DueDate" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        document.getElementById('productCode').addEventListener('blur', async function () {
            const code = this.value.trim();
            const errorEl = document.getElementById('productCodeError');
            const nameEl = document.getElementById('productName');
            const idEl = document.getElementById('productId');

            errorEl.textContent = '';
            nameEl.value = '';
            idEl.value = '';

            if(!code) {
                return;
            }

            const response = await fetch('/ProductionOrders/FindProductByCode?code=${encodeURIComponent(code)}');
            if(response.ok) {
                const product = await response.json();
                nameEl.value = product.name;
                idEl.value = product.id;
            } else {
                errorEl.textContent = 'Product not found.';
            }
        });
    </script>
}
