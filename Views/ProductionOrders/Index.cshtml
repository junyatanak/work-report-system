@model List<DailyWorkReport.ViewModels.ProductionOrder.ProductionOrderDisplayViewModel>


@{
    ViewData["Title"] ="Production Orders";
}

<div class=d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Production Orders</h1>
    <a asp-action="Create" class="btn btn-primary btn-sm">
        <i class="bi bi-plus-lg me-1"></i>New Order
    </a>
</div>

<table class="table table-hover align-middle">
    <thead>
        <tr>
            <th>Order Number</th>
            <th>Product</th>
            <th>Order Qty</th>
            <th>Due Date</th>
            <th>Status</th>
        </tr>
    </thead>
    <tbody>
        @foreach(var item in Model)
        {
            <tr>
                <td>@item.OrderNumber</td>
                <td>@item.ProductName</td>
                <td>@item.OrderQty</td>
                <td>@item.DueDate.ToString("yyyy-mm-dd")</td>
                <td>
                    @if(item.IsReported)
                    {
                        <span class="badge bg-success">Reported</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">Not Reported</span>
                    }
                </td>
            </tr>
        }
    </tbody>
</table>