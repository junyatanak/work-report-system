@model List<DailyWorkReport.ViewModels.Navigation.MenuItemViewModel>

<ul class="nav flex-colum p-2">
    @foreach (var item in Model){
        if(item.SubItems.Any()){
            var collapseId = $"collapse-{item.Text.Replace(" ","")}";
            <li class="nav-item mb-1">
                <a class="nav-link text-dark d-flex align-items-center" data-bs-toggle="collapse" href="#@collapseId" role="button" aria-expanded="false">
                    <i class="bi @item.IconClass me-2"></i>@item.Text
                    <i class="bi bi-chevron-down-ms-auto small"></i>
                </a>
                <div class="collapse" id="@collapseId">
                    <ul class="nav flex-column ps-4">
                        @foreach (var subItem in item.SubItems){
                            <li class="nav-item">
                                <a class="nav-link text-dark py-1" asp-controller="@subItem.Controller" asp-action="@subItem.Action">
                                    @subItem.Text
                                </a>
                            </li>
                        }
                    </ul>
                </div>

            </li>
        }
    }
</ul>