@model DailyWorkReport.ViewModels.StandardWorkTime.StandardWorkTimeCreateViewModel

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>StandardWorkTime</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="WorkClassId" class="control-label"></label>
                <select asp-for="WorkClassId" class ="form-control" asp-items="ViewBag.WorkClassId">
                    <option value="">-- Select Work Class --</option>
                </select>
                <span asp-validation-for="WorkClassId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ProcessId" class="control-label"></label>
                <select asp-for="ProcessId" class ="form-control" asp-items="ViewBag.ProcessId">
                    <option value="">-- Select Process --</option>
                </select>
                <span asp-validation-for="ProcessId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="WorkPatternId" class="control-label"></label>
                <select asp-for="WorkPatternId" class ="form-control" asp-items="ViewBag.WorkPatternId">
                    <option value="">-- Select Work Pattern --</option>
                </select>
                <span asp-validation-for="WorkPatternId" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="StandardWorkTime" class="control-label"></label>
                <input asp-for="StandardWorkTime" class="form-control" />
                <span asp-validation-for="StandardWorkTime" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
    <a asp-action="Index">Back to List</a>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
