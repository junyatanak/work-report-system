@model PagedViewModel<DailyWorkReport.ViewModels.StandardWorkTime.StandardWorkTimeDisplayViewModel>

@{
    ViewData["Title"] = "Standard Work Times";
}

<h1>Standard Work Times</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Items[0].WorkClassName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Items[0].ProcessName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Items[0].WorkPatternName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Items[0].StandardWorkTime)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Items) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.WorkClassName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.ProcessName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.WorkPatternName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.StandardWorkTime)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.Id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.Id">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

<partial name="_Pagination" model="Model.Paging" />

